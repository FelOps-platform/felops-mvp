{
  "name": "felops",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm --filter @felops/widget build && turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @felops/db db:generate",
    "db:migrate": "pnpm --filter @felops/db db:migrate",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "e2e": "pnpm --filter @felops/web e2e",
    "pretest": "pnpm --filter @felops/db db:migrate:test",
    "start": "pnpm --filter @felops/web start",
    "worker": "pnpm --filter @felops/worker start"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.20.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
