# Postgres 16 + pgvector. docker-compose publishes it on 5433 locally.
DATABASE_URL=postgres://felops:felops@localhost:5433/felops
TEST_DATABASE_URL=postgres://felops:felops@localhost:5433/felops_test
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-long-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=sk-test
CHAT_MODEL=gpt-4.1-mini
CHAT_MODEL_FALLBACK=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=felops
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=Felops <no-reply@felops.local>
# Local development without a real OpenAI key uses deterministic embeddings and
# an extractive answer fallback. Remove this in production.
MOCK_AI=1
